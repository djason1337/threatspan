{
  "name": "threatspan",
  "version": "1.1.2",
  "description": "A fast, keyboard-first investigation workspace for SOC analysts. Enriches IPs / domains / URLs / hashes with VirusTotal, AbuseIPDB, IPQS, Shodan, GreyNoise, URLhaus, ThreatFox, MalwareBazaar, OTX, Sucuri, urlscan.io, GeoIP, DNS, WHOIS — plus CISA KEV cross-reference and MITRE ATT&CK enrichment.",
  "keywords": [
    "soc",
    "security",
    "threat-intel",
    "threat-intelligence",
    "ioc",
    "investigation",
    "virustotal",
    "abuseipdb",
    "shodan",
    "greynoise",
    "mitre",
    "attack",
    "cisa-kev",
    "malware-analysis",
    "incident-response",
    "blue-team"
  ],
  "homepage": "https://github.com/djason1337/threatspan",
  "bugs": {
    "url": "https://github.com/djason1337/threatspan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djason1337/threatspan.git"
  },
  "license": "MIT",
  "main": "server.js",
  "bin": {
    "threatspan": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node -e \"console.log('No tests yet — run: npm start')\"",
    "build:binaries": "bash scripts/build-binaries.sh"
  },
  "files": [
    "server.js",
    "threatspan.html",
    "threatspan",
    "ThreatSpan.command",
    "ThreatSpan.cmd",
    "examples/",
    "docs/",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "preferGlobal": true,
  "pkg": {
    "scripts": "server.js",
    "assets": [
      "threatspan.html",
      "package.json"
    ],
    "targets": [
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-linux-x64",
      "node18-linux-arm64",
      "node18-win-x64"
    ],
    "outputPath": "dist/binaries"
  }
}
